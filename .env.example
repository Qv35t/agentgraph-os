# Optional Phase 3 local OpenCode bridge configuration.
AGENTGRAPH_OPENCODE_BASE_URL=
AGENTGRAPH_OPENCODE_BASIC_AUTH_USERNAME=
AGENTGRAPH_OPENCODE_BASIC_AUTH_PASSWORD=

# Local Ollama needs no secret.
AGENTGRAPH_OLLAMA_BASE_URL=

# Optional OpenAI-compatible API base ending in /v1 (for example OpenRouter).
AGENTGRAPH_OPENAI_COMPATIBLE_BASE_URL=
AGENTGRAPH_OPENAI_COMPATIBLE_API_KEY=

# Remote API control remains disabled unless explicitly enabled. Policies are a
# JSON object mapping identities to permissions, for example {"local-user":["read","execute"]}.
# Set AGENTGRAPH_REMOTE_CONTROL_ENABLED, AGENTGRAPH_REMOTE_CONTROL_POLICIES,
# and optionally AGENTGRAPH_PROJECT_ID only in a user-owned .env file.

# Optional non-secret frontend development overrides. Relative local defaults
# work without these values.
# Set VITE_AGENTGRAPH_API_URL, VITE_AGENTGRAPH_WS_URL, and
# VITE_AGENTGRAPH_IDENTITY only in a user-owned frontend .env file.
