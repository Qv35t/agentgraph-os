{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "watcher": {
    "ignore": [
      "**/.git/**",
      "**/.env",
      "**/.env.*",
      "**/.envrc",
      "**/.venv/**",
      "**/node_modules/**",
      "**/dist/**",
      "**/build/**",
      "**/.cache/**",
      "**/qdrant_storage/**",
      "**/*.db",
      "**/*.sqlite",
      "**/*.sqlite3",
      "**/credentials/**",
      "**/secrets/**",
      "**/*.pem",
      "**/*.key"
    ]
  }
}
