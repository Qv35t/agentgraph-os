# Distributed Core/Worker v1 is disabled by default.
AGENTGRAPH_NODE_ROLE=core
AGENTGRAPH_WORKER_ENABLED=false
# Worker-only: use a private Core URL and a separately provisioned enrollment secret.
AGENTGRAPH_CORE_URL=
AGENTGRAPH_NODE_NAME=AgentGraph Worker
AGENTGRAPH_NODE_ID_PATH=./data/worker-node-id
AGENTGRAPH_WORKER_ENROLLMENT_SECRET=
AGENTGRAPH_WORKER_HEARTBEAT_INTERVAL_SECONDS=10
AGENTGRAPH_WORKER_HEARTBEAT_TIMEOUT_SECONDS=30
